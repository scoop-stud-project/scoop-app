@startuml c4-level-3-component
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Component.puml

LAYOUT_WITH_LEGEND()

title Component Diagram for SCoop — Django Backend Container (C4 Level 3)

Container(ui, "Web Browser / UI Layer", "HTML / Tailwind CSS", "Responsive frontend views and user interactions")
ContainerDb(db, "Relational Database", "PostgreSQL", "Persistent storage (Profiles, Projects, RoleSlots, Requests, RoleAssignments, PeerReviews, Dictionaries)")
System_Ext(resend_api, "Resend API", "External Email Service", "Transactional email delivery")

Container_Boundary(django_backend, "Web Application Backend (Python / Django)") {
    Component(account_comp, "Account, Profile & Data Protection Component", "Django Module", "Handles university email registration, verification gating, 16+/ToS/cookie consent, profile & skill/role/goal preferences, JSON export, account deletion, and admin dictionary/moderation (FR01–FR08, FR43–FR47)")
    Component(project_comp, "Project & Casting Configuration Component", "Django Module", "Manages project creation, RoleSlots & templates, project lifecycle states, tags, event/org links, and private workspace links (FR09–FR16)")
    Component(match_comp, "Matchmaking & Discovery Component", "Django Module", "Computes deterministic 0–100% compatibility scores & breakdowns, ranks open RoleSlots and candidate profiles, and filters by skills/tags/goals/events (FR17–FR23)")
    Component(recruit_comp, "Recruitment & Team Formation Component", "Django Module", "Handles applications/invitations, duplicate/membership checks, request decisions/withdrawals, RoleSlot assignment & closing, team formation locking, workspace link visibility, and early departures (FR24–FR36)")
    Component(review_comp, "Peer Review & Reliability Component", "Django Module", "Manages post-finish teammate reviews (1–5 rating, 14-day window, review reporting) and recalculates reliability scores on review submission or early departure (FR37–FR42)")
    Component(notify_comp, "Notification / Email Integration Adapter", "Django Adapter", "Encapsulates Resend API calls for email verification and recruitment notifications (FR02, FR33)")
}

Rel(ui, account_comp, "Auth, profile, privacy & admin actions", "HTTPS")
Rel(ui, project_comp, "Project & RoleSlot configuration", "HTTPS")
Rel(ui, match_comp, "Browse & filter roles/candidates", "HTTPS")
Rel(ui, recruit_comp, "Apply, invite, respond & view team/links", "HTTPS")
Rel(ui, review_comp, "Submit & report peer reviews", "HTTPS")

' Inter-component dependencies
Rel(account_comp, notify_comp, "Requests verification email dispatch (FR02)")
Rel(account_comp, review_comp, "Delegates review moderation actions (FR47)")

Rel(project_comp, account_comp, "Verifies student email status & reads dictionaries/tags/events (FR03, FR12–FR13)")

Rel(match_comp, account_comp, "Reads student profiles, skills, preferences & reliability scores (FR17–FR22)")
Rel(match_comp, project_comp, "Reads published projects, RoleSlots, tags & linked events (FR17–FR23)")

Rel(recruit_comp, account_comp, "Verifies email status & reads user profiles/reliability (FR03, FR24–FR27)")
Rel(recruit_comp, project_comp, "Reads & updates RoleSlots, team readiness & workspace link access (FR24–FR36)")
Rel(recruit_comp, notify_comp, "Triggers invitation, decision & team-formed notifications (FR33)")
Rel(recruit_comp, review_comp, "Notifies of early member departure for reliability adjustment (FR35, FR40)")

Rel(review_comp, account_comp, "Updates user reliability score & completed project metrics (FR39–FR41)")
Rel(review_comp, recruit_comp, "Verifies project completion & team membership eligibility (FR37–FR38)")

' Database & external API dependencies
Rel(account_comp, db, "Reads/writes Users, Profiles, Consents & Dictionaries", "ORM / SQL")
Rel(project_comp, db, "Reads/writes Projects, RoleSlots & WorkspaceLinks", "ORM / SQL")
Rel(match_comp, db, "Reads indexed Profiles, RoleSlots & Projects", "ORM / SQL")
Rel(recruit_comp, db, "Reads/writes Requests, RoleAssignments & RoleSlots", "ORM / SQL")
Rel(review_comp, db, "Reads/writes PeerReviews & ReviewReports", "ORM / SQL")
Rel(notify_comp, resend_api, "Sends transactional emails", "HTTPS / REST API")

@enduml